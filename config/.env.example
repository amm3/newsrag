# Qdrant RAG Loader Configuration
# Copy to .env and fill in your values

# =============================================================================
# Wallabag Configuration
# =============================================================================
# Your Wallabag instance URL (no trailing slash)
WALLABAG_URL=https://wallabag.example.com

# API client credentials (create at https://your-wallabag/developer)
WALLABAG_CLIENT_ID=your_client_id
WALLABAG_CLIENT_SECRET=your_client_secret

# Your Wallabag login credentials
WALLABAG_USERNAME=your_username
WALLABAG_PASSWORD=your_password

# =============================================================================
# Qdrant Configuration
# =============================================================================
# Qdrant server URL
QDRANT_URL=http://localhost:6333

# API key for Qdrant (generate with: openssl rand -base64 32)
QDRANT_API_KEY=your_qdrant_api_key

# Collection names
WALLABAG_COLLECTION=wallabag_articles
PODCAST_COLLECTION=podcast_transcripts

# =============================================================================
# OpenAI Configuration
# =============================================================================
# API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# Embedding model (text-embedding-3-small is recommended for cost/quality)
EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# Podcast Configuration
# =============================================================================
# Default podcast directory (can be overridden with --podcast-dir)
PODCAST_DIR=/mnt/nas/podcasts

# =============================================================================
# Papers Configuration
# =============================================================================
# Directory containing papers/documents (can be overridden with --papers-dir)
PAPERS_DIR=/mnt/nas/papers

# Collection name in Qdrant
PAPERS_COLLECTION=papers

# =============================================================================
# AI Summaries Configuration
# =============================================================================
# Chat model used to generate summaries (Phase 1: ./run.sh summarize)
SUMMARY_MODEL=gpt-5.6-luna

# Simple truncation guard on source text sent to the summarization model
# (no map-reduce yet, so very long transcripts/papers get cut off at this length)
SUMMARY_MAX_INPUT_CHARS=100000

# Collection name for AI-generated summaries (Phase 2: ./run.sh summaries)
SUMMARIES_COLLECTION=summaries

SUMMARY_CHUNK_SIZE=2000
SUMMARY_CHUNK_OVERLAP=400

# When generating tags for a summary, Phase 1 reuses the Wallabag credentials
# above to pull the tag list already in use, so new tags stay consistent with
# existing ones. Caps how many of those tags go into the prompt (most recently
# created first); 0 disables the lookup entirely, as does --no-tag-vocab.
# Missing/unreachable Wallabag config is not an error - summaries are still
# generated, tags just fall back to the naming conventions alone.
SUMMARY_TAG_VOCAB_LIMIT=300

# =============================================================================
# Feeds (RSS/Atom) Configuration
# =============================================================================
# Feed list is defined in config/feeds.yaml (copy from feeds.yaml.example)

# Optional Firecrawl API key (leave blank for self-hosted without auth)
FIRECRAWL_API_KEY=

# Collection name in Qdrant
FEEDS_COLLECTION=news_feeds

# =============================================================================
# Processing Options
# =============================================================================
# Chunk size in characters (larger = more context per chunk, fewer chunks)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# For podcasts (transcripts benefit from larger context)
PODCAST_CHUNK_SIZE=1500
PODCAST_CHUNK_OVERLAP=300

# For papers (longer-form writing benefits from even larger context)
PAPERS_CHUNK_SIZE=2000
PAPERS_CHUNK_OVERLAP=400

# For feeds (news articles)
FEEDS_CHUNK_SIZE=1000
FEEDS_CHUNK_OVERLAP=200

# =============================================================================
# Static File Server URLs (for linking to source files in search results)
# =============================================================================
# Base URL for papers served via static web server (used by OpenWebUI tool)
PAPERS_BASE_URL=https://static-lan.maddock.net/papers

# Base URL for podcasts served via static web server (used by OpenWebUI tool)
PODCASTS_BASE_URL=https://static-lan.maddock.net/podcasts

# =============================================================================
# Kindle Highlights Configuration
# =============================================================================
# Directory containing Bookcision JSON export files
KINDLE_JSON_DIR=/path/to/kindle/exports

# Collection name in Qdrant
KINDLE_COLLECTION=kindle_highlights

# =============================================================================
# OpenWebUI Chat History Configuration
# =============================================================================
# URL of your OpenWebUI instance (no trailing slash)
OPENWEBUI_URL=http://localhost:3000

# API key — generate in OpenWebUI: Settings → Account → API Key
OPENWEBUI_API_KEY=your_openwebui_api_key

# Collection name in Qdrant
OPENWEBUI_COLLECTION=openwebui_chats

# Chunk size for message content (chars). Long messages (code blocks, pasted docs)
# are split into overlapping chunks — same pattern as all other loaders.
# 1000 chars is safe even for code-heavy content (500 tokens worst-case).
OPENWEBUI_CHUNK_SIZE=1000
OPENWEBUI_CHUNK_OVERLAP=200

# =============================================================================
# Alert / Notification (optional — leave ALERT_SMTP_HOST blank to disable)
# =============================================================================
# SMTP server for fatal-error alerts from any loader
# e.g. Gmail: smtp.gmail.com port 587 (use an App Password, not your login password)
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASS=
ALERT_FROM=qdrant-loader@example.com
# Comma-separated list of recipient addresses
ALERT_TO=you@example.com

# -----------------------------------------------------------------------------
# Health check (./run.sh health)
# -----------------------------------------------------------------------------
# The loaders alert when they fail outright. The health check catches the quieter
# failure: a source that has simply stopped advancing, because runs are crashing,
# because cron stopped firing, or because something upstream went away. It reads
# the 'last_sync' stamp each loader writes to its state file in this directory.
#
# Every loader stamps last_sync on a run that finishes, whether or not it found
# anything new, so a stale stamp means runs have stopped -- not that the source
# has been quiet.
#
# Which sources to watch. One or more of:
#   feeds, wallabag, podcasts, papers, summaries, kindle, openwebui
# List the ones you actually run on a schedule: a source you only run by hand
# has no recent stamp and would look permanently stale.
#
# 'papers' covers every collection it finds a state file for, each judged
# separately, so one collection stalling cannot hide behind another. Name a
# single one as 'papers:<collection>' -- which is also how to watch a
# collection that has not written state yet.
HEALTH_CHECKS=feeds
# Alert once a source is this many hours behind. Set it above the gap between
# scheduled runs, with room for one missed run and the runtime itself -- a feed
# ingest every 2 hours wants about 6, a daily one more than 24.
HEALTH_STALE_HOURS=36
# Per-source override, for sources on their own cadence:
# HEALTH_STALE_HOURS_FEEDS=6
# HEALTH_STALE_HOURS_WALLABAG=2
# ...and per papers collection, most specific first:
# HEALTH_STALE_HOURS_PAPERS=6
# HEALTH_STALE_HOURS_PAPERS_MY_THOUGHTS=168
# Minimum gap between repeat alerts about the same source, so a frequent cron
# doesn't mail on every run for as long as something stays broken.
HEALTH_REALERT_HOURS=24

# -----------------------------------------------------------------------------
# Concurrency
# -----------------------------------------------------------------------------
# Each run claims its state file while it works, so an overlapping run skips
# instead of racing it and losing one of the two runs' state. Set this to
# disable that -- only worth doing if config/ lives on a filesystem where flock
# misbehaves, such as NFS.
# QDRANT_LOADER_NO_LOCK=1
