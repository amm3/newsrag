# Virtual environment
venv/
.venv/

# Configuration with secrets
config/.env
config/.env.bak*

# Sync state files (incl. per-collection ones like .papers_sync_state_misc.json)
config/.*_state*.json

# Lock files, created at runtime beside the state file they guard
config/*.lock

# Half-written state left by a crashed atomic write. A feeds state file is
# keyed by feed URL, so this must not reach the public mirror either.
config/*.tmp

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
.claude/

# Feed / scrape target list (a personal reading list, not for the public mirror)
config/feeds.yaml
